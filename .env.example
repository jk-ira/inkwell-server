PORT=4000
NODE_ENV=development

# Local PostgreSQL (no containers). Change user/password/host to match your install.
DATABASE_URL=postgres://user:password@localhost:5432/social_publisher

DB_SSL=false

# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=**********************
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=https://inkwell-web-client.vercel.app

# Frontend base URL used to build share links: <PUBLIC_APP_URL>/posts/<slug>
PUBLIC_APP_URL=https://inkwell-web-client.vercel.app/

# Rate limits (per IP per 15 minutes)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# First administrator, created by: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=*******

TRUST_PROXY=true
